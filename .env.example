# --- LLM extraction (recommended) ---------------------------------------
# The service uses Claude for memory extraction. Without a key it falls back
# to a rule-based extractor (works, but much lower extraction quality —
# see README: Failure modes). Left commented so an unedited copy of this
# file can't inject a bogus literal key and silently degrade extraction.
# ANTHROPIC_API_KEY=sk-ant-...

# Extraction model. claude-opus-4-8 is the default used for every committed
# self-eval run. claude-sonnet-4-6 is a faster/cheaper alternative (not
# benchmarked on the fixture — run scripts/selfeval.py after switching to
# measure the quality difference yourself).
# MEMORY_LLM_MODEL=claude-opus-4-8

# --- Optional auth --------------------------------------------------------
# If set, every endpoint except /health requires
# "Authorization: Bearer <token>". If unset, auth is disabled.
# MEMORY_AUTH_TOKEN=

# --- Tuning (defaults are calibrated; see CHANGELOG) ----------------------
# All knobs below are forwarded by docker-compose.yml, so setting them in
# .env works in the documented compose flow.
# MEMORY_DB_PATH=/data/memory.db
#
# NOTE: the three retrieval floors are calibrated for bge-small-en-v1.5's
# similarity distribution. If you change MEMORY_EMBEDDING_MODEL, re-run
# scripts/calibrate_gate.py (method + readings in CHANGELOG v0.4/v0.7) and
# set the floors to match.
# MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MEMORY_DENSE_FLOOR=0.62
# MEMORY_DENSE_FLOOR_LOW=0.50
# MEMORY_TERM_FLOOR=0.52
# MEMORY_RRF_K=60
# MEMORY_HOP_DAMPING=0.5
#
# /turns latency budget: per-attempt SDK timeout, retry count, and the hard
# wall-clock deadline on the whole extraction call. Defaults keep worst-case
# /turns comfortably inside the eval's 60s timeout.
# MEMORY_LLM_TIMEOUT_S=20
# MEMORY_LLM_MAX_RETRIES=1
# MEMORY_EXTRACTION_DEADLINE_S=40
