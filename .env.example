# --- LLM extraction (recommended) ---------------------------------------
# The service uses Claude for memory extraction. Without a key it falls back
# to a rule-based extractor (works, but much lower extraction quality —
# see README: Failure modes).
ANTHROPIC_API_KEY=sk-ant-...

# Extraction model. claude-opus-4-8 (default) gave the best extraction
# quality on the self-eval fixture. claude-sonnet-4-6 is a faster/cheaper
# alternative if extraction latency matters more than quality.
# MEMORY_LLM_MODEL=claude-opus-4-8

# --- Optional auth --------------------------------------------------------
# If set, every endpoint except /health requires
# "Authorization: Bearer <token>". If unset, auth is disabled.
# MEMORY_AUTH_TOKEN=

# --- Tuning (defaults are calibrated; see CHANGELOG) ----------------------
# MEMORY_DB_PATH=/data/memory.db
# NOTE: the two DENSE_FLOOR values are calibrated for bge-small-en-v1.5's
# similarity distribution. If you change MEMORY_EMBEDDING_MODEL, re-run the
# calibration (method in CHANGELOG v0.4) and set the floors to match.
# MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MEMORY_DENSE_FLOOR=0.62
# MEMORY_DENSE_FLOOR_LOW=0.50
# MEMORY_RRF_K=60
# MEMORY_HOP_DAMPING=0.5
# MEMORY_LLM_TIMEOUT_S=45
# MEMORY_LLM_MAX_RETRIES=2
